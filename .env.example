# ==============================================================================
# Antioch Syrian University (ASU) - Backend Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the values for your target environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Security & Debug Settings
# ------------------------------------------------------------------------------
# Secret key for Django cryptographic signing (generate a strong key for production)
SECRET_KEY=your_django_secret_key_here

# Enable debug mode (True for development, False for production)
DEBUG=True


# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=<mode>
# Localhost PostgreSQL example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/ASU

# Cloud PostgreSQL (Neon / Supabase / RDS) example:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/ASU?sslmode=require


# ------------------------------------------------------------------------------
# 3. Frontend & CORS Allowed Origin
# ------------------------------------------------------------------------------
# URL of the Next.js frontend application allowed to communicate with this backend API
# Localhost:
FRONTEND_URL=http://localhost:3000

# Production:
# FRONTEND_URL=https://asu-front-end.vercel.app


# ------------------------------------------------------------------------------
# 4. Media & File Storage Configuration
# ------------------------------------------------------------------------------
# Storage Provider: 'local' (disk storage for localhost/VPS) or 'cloudinary' (cloud storage for Vercel)
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=cloudinary

# Cloudinary Credentials (Required only when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
